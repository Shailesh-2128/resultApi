# Django Settings
SECRET_KEY=django-insecure-change-me-in-production-key-9034823904
DEBUG=True
ALLOWED_HOSTS=matkaresult.kingwins.pro,localhost,127.0.0.1,*
CSRF_TRUSTED_ORIGINS=https://matkaresult.kingwins.pro,http://matkaresult.kingwins.pro
TIME_ZONE=Asia/Kolkata

# Database (Supabase PostgreSQL or standard Postgres URL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres.xxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# External Result API Credentials
RESULT_API_URL=https://api.example.com/v1/results
RESULT_API_KEY=your_secret_api_key_here
RESULT_API_DOMAIN=api.example.com

# Polling Rules
RESULT_POLL_INTERVAL=5
# RESULT_MAX_POLL_MINUTES= (leave empty/unset for unlimited polling)
# RESULT_MAX_RETRIES= (leave empty/unset for unlimited polling)

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
