[Unit]
Description=Celery Worker service for Results Management Application
After=network.target redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/results_project
ExecStart=/var/www/results_project/venv/bin/celery -A config worker -l info --concurrency=4
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
