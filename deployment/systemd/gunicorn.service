[Unit]
Description=Gunicorn daemon for Django Results Management Application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/results_project
ExecStart=/var/www/results_project/venv/bin/gunicorn --config gunicorn.conf.py config.wsgi:application
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
